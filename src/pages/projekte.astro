---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const projects = [
	{
		title: "Borin AI",
		description:
			"Ein KI-Sprachmodell für Schüler von Schülern. Ein innovatives Tool, das komplexe Schulthemen verständlich erklärt und beim Lernen unterstützt.",
		tags: ["AI", "Education", "Frontend"],
		link: "https://borinai.github.io",
	},
	{
		title: "Coming Soon",
		description:
			"Ein neues Projekt ist in der Konzeptionsphase. Hier wird bald etwas Spannendes entstehen.",
		tags: ["Development"],
		link: "",
	},
	{
		title: "Coming Soon",
		description:
			"Hier werden kommende Projekte präsentiert. Bleib auf dem Laufenden!",
		tags: ["Design"],
		link: "",
	},
];
---
<MainGridLayout title="Projekte" description="Aktuelle Projekte von Imacikus">
	<div class="flex flex-col gap-4 w-full">
		{projects.map((p) => (
			<article class="card-base rounded-[var(--radius-large)] overflow-hidden relative">
				<div class="px-6 md:px-9 py-6">
					<div class="flex items-center mb-3">
						<div
							class="h-8 w-8 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-3">
							<Icon name="fa6-solid:rocket" class="text-lg"></Icon>
						</div>
						<h2 class="font-bold text-3xl text-90">{p.title}</h2>
					</div>
					<div class="flex flex-wrap gap-2 mb-4">
						{p.tags.map((t) => (
							<span class="btn-regular h-8 text-sm px-3 rounded-lg text-[var(--btn-content)] font-medium">
								#{t}
							</span>
						))}
					</div>
					<p class="text-75 leading-relaxed max-w-2xl">{p.description}</p>
					{p.link && (
						<a href={p.link} target="_blank" rel="noopener noreferrer"
						   class="btn-regular h-10 px-4 rounded-lg font-bold mt-5 w-fit text-[var(--primary)]">
							Live ansehen
							<Icon name="fa6-solid:arrow-up-right-from-square" class="text-sm ml-2"></Icon>
						</a>
					)}
				</div>
			</article>
		))}
	</div>
</MainGridLayout>